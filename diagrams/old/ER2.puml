@startuml ER2

' Скрываем лишние элементы для чистоты
hide circle
skinparam linetype ortho

entity "Пользователь" {
  * email
  --
  полное_имя
  телефон
  роль
}

entity "Продавец" {
  * название_компании
  --
  описание
  рейтинг
}

entity "Товар" {
  * название
  --
  описание
  цена
  количество_на_складе
}

entity "Категория" {
  * название
  --
  описание
}

entity "Заказ" {
  * статус
  --
  итоговая_сумма
}

entity "Позиция заказа" {
  * количество
  --
  цена_на_момент_покупки
}

entity "Отзыв" {
  * оценка (1–5)
  --
  комментарий
}

entity "Адрес" {
  * город
  --
  улица
  индекс
  основной (да/нет)
}

entity "История цен" {
  * старая_цена
  --
  новая_цена
  дата_изменения
}

' === Связи ===

Пользователь ||--o| Продавец : "имеет профиль"
Пользователь ||--o{ Заказ : "оформляет"
Пользователь ||--o{ Адрес : "имеет"
Пользователь ||--o{ Отзыв : "оставляет"

Продавец ||--o{ Товар : "владеет"

Товар }o--o{ Категория : "относится к"
Товар ||--o{ Отзыв : "имеет"
Товар ||--o{ "История цен" : "имеет"

Категория ||--o{ Категория : "содержит"

Заказ ||--o{ "Позиция заказа" : "содержит"
Заказ }o--o| Адрес : "доставляется на"

"Позиция заказа" }o--|| Товар : "включает"

@enduml

@startuml C4_L4_Service
title Компонент бизнес-логики — component/service и пакет service (C4 L4)

skinparam classAttributeIconSize 0
left to right direction

package "component/service" {
    class ServiceComponent as "Component" {
        +User: UserService
        +Seller: SellerService
        +Address: AddressService
        +Review: ReviewService
        +Product: ProductService
        +Order: OrderService
        +Category: CategoryService
        +Auth: AuthService
        +Payment: *PaymentService
    }

    class ServiceConfig as "Config" {
        +BcryptCost: int
        +JWTSecret: string
        +TokenTTL: time.Duration
        +PaymentTTL: time.Duration
        +PaymentGatewayBaseURL: string
        +TokenBlocklist: TokenBlocklist
    }
}

package "service" {
    class AuthService {
        -userProvider: AuthUserProvider
        -blocklist: TokenBlocklist
        -secret: string
        -tokenTTL: time.Duration
        +Register(ctx, uc): string, error
        +Login(ctx, email, password): string, error
        +Logout(ctx, claims): error
        +ValidateToken(ctx, token): TokenClaims, error
    }

    class UserService {
        -repo: UserRepo
        -bcryptCost: int
        +CreateUser(ctx, uc): int64, error
        +GetUsers(ctx, actor, opts): []User, error
        +GetUserByID(ctx, actor, id): User, error
        +UpdateUser(ctx, actor, id, uu): User, error
        +ChangePasswordUser(ctx, actor, oldPass, newPass): error
        +DeleteUserByID(ctx, actor, id): error
    }

    class SellerService {
        -sellerRepo: SellerRepo
        +GetSellerByID(ctx, id): Seller, error
        +GetSellerByUserID(ctx, actor): Seller, error
        +CreateSeller(ctx, actor, sc): int64, error
        +UpdateSeller(ctx, actor, id, su): Seller, error
        +DeleteSellerByID(ctx, actor, id): error
        +GetSellerStats(ctx, sellerID, from, to): SellerStats, error
    }

    class ProductService {
        -productRepo: ProductRepo
        -reviewRepo: ReviewRepo
        -sellerRepo: SellerRepo
        +GetProducts(ctx, options): []Product, error
        +GetProductByID(ctx, id): Product, error
        +GetProductPriceHistory(ctx, pid, from, to): []ProductPriceHistory, error
        +GetReviewsByProductID(ctx, pid, opts): []Review, error
        +CreateProduct(ctx, actor, pc): int64, error
        +UpdateProduct(ctx, actor, id, pu): Product, error
        +DeleteProductByID(ctx, actor, id): error
    }

    class OrderService {
        -orderRepo: OrderRepo
        -orderItemRepo: OrderItemRepo
        -productRepo: ProductRepo
        -sellerGetter: SellerGetter
        -txManager: TxManager
        +GetCart(ctx, actor): Order, error
        +AddItemToCart(ctx, actor, productID, qty): error
        +Checkout(ctx, actor, addressID): []int64, error
        +PayOrder(ctx, actor, orderID): error
        +CancelOrder(ctx, actor, orderID): error
        +ShipOrder(ctx, actor, orderID): error
        +DeliverOrder(ctx, actor, orderID): error
        +ExpirePendingOrders(ctx, deadline): int, error
    }

    class PaymentService {
        -orderRepo: OrderRepo
        -gateway: PaymentGateway
        -paymentTTL: time.Duration
        -Clock: Clock
        +GetOrderPaymentURL(ctx, actor, orderID): string, time.Time, error
        +ProcessOrderPayment(ctx, token): error
    }

    class ReviewService {
        -reviewRepo: ReviewRepo
        +GetReviewByID(ctx, id): Review, error
        +CreateReview(ctx, actor, rc): int64, error
        +UpdateReview(ctx, actor, id, ru): Review, error
        +DeleteReviewByID(ctx, actor, id): error
    }

    class AddressService {
        -addressRepo: AddressRepo
        +GetAddressesByUserID(ctx, actor): []Address, error
        +CreateAddress(ctx, actor, ac): int64, error
        +UpdateAddress(ctx, actor, id, au): Address, error
        +DeleteAddressByID(ctx, actor, id): error
    }

    class CategoryService {
        -categoryRepo: CategoryRepo
        +GetCategories(ctx, opts): []Category, error
        +GetCategoryByID(ctx, id): Category, error
        +CreateCategory(ctx, actor, cc): int64, error
        +UpdateCategory(ctx, actor, id, cu): Category, error
        +DeleteCategoryByID(ctx, actor, id): error
    }

    class OrderExpirationWorker {
        -orderExpirer: OrderExpirer
        -interval: time.Duration
        -paymentTTL: time.Duration
        -logger: *slog.Logger
        +Run(ctx): void
    }

    class Actor {
        +UserID: int64
        +Role: UserRole
        +HasRole(roles ...UserRole): bool
        +IsAdmin(): bool
    }

    interface AuthUserProvider
    interface TokenBlocklist
    interface UserRepo
    interface SellerRepo
    interface ProductRepo
    interface OrderRepo
    interface OrderItemRepo
    interface ReviewRepo
    interface AddressRepo
    interface CategoryRepo
    interface SellerGetter
    interface TxManager
    interface PaymentGateway
    interface Clock
    interface OrderExpirer
}

package "repository component" {
    class RepositoryComponent as "component/repository.Component" {
        +User: UserRepo
        +Seller: SellerRepo
        +Address: AddressRepo
        +Review: ReviewRepo
        +Product: ProductRepo
        +Order: OrderRepo
        +OrderItem: OrderItemRepo
        +Category: CategoryRepo
        +TxManager: TxManager
    }
}

package "adapter/payment" {
    class MockBankGateway {
        -baseURL: string
        +GetPaymentURL(ctx, payload): string, error
        +ProcessPayment(ctx, token): PaymentResult, error
    }
}

ServiceConfig --> ServiceComponent : параметры
RepositoryComponent --> ServiceComponent : зависимости
ServiceComponent *-- UserService
ServiceComponent *-- SellerService
ServiceComponent *-- AddressService
ServiceComponent *-- ReviewService
ServiceComponent *-- ProductService
ServiceComponent *-- OrderService
ServiceComponent *-- CategoryService
ServiceComponent *-- AuthService
ServiceComponent *-- PaymentService

AuthService o--> AuthUserProvider
AuthService o--> TokenBlocklist
UserService o--> UserRepo
SellerService o--> SellerRepo
ProductService o--> ProductRepo
ProductService o--> ReviewRepo
ProductService o--> SellerRepo
OrderService o--> OrderRepo
OrderService o--> OrderItemRepo
OrderService o--> ProductRepo
OrderService o--> SellerGetter
OrderService o--> TxManager
PaymentService o--> OrderRepo
PaymentService o--> PaymentGateway
PaymentService o--> Clock
ReviewService o--> ReviewRepo
AddressService o--> AddressRepo
CategoryService o--> CategoryRepo
OrderExpirationWorker o--> OrderExpirer

MockBankGateway ..|> PaymentGateway : реализует

note right of ServiceComponent
  component/service является фасадом сборки:
  принимает repository component и config,
  создаёт все сервисы бизнес-логики,
  затем отдаёт их UI/API слоям.
end note

note bottom of OrderService
  Бизнес-логика держит транзакционные
  сценарии через TxManager и не знает
  о конкретном pgxpool напрямую.
end note

@enduml

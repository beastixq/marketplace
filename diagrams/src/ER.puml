@startuml ER

hide circle
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 130

entity "Пользователь" as users {
  * id
  --
  email <<unique>>
  password_hash
  full_name
  phone <<unique>>
  role
  created_at
  deleted_at
}

entity "Продавец" as sellers {
  * id
  --
  user_id <<unique>>
  company_name
  description
  rating
  created_at
}

entity "Товар" as products {
  * id
  --
  seller_id
  name
  description
  price
  stock_quantity
  reserved_quantity
  rating
  created_at
  deleted_at
}

entity "Категория" as categories {
  * id
  --
  parent_id
  name <<unique>>
  description
}

entity "Категория товара" as product_categories {
  * product_id
  * category_id
}

entity "Адрес" as addresses {
  * id
  --
  user_id
  city
  street
  house
  apartment
  zip_code
  is_default
  created_at
}

entity "Заказ" as orders {
  * id
  --
  user_id
  address_id
  seller_id
  status
  total_amount
  created_at
  updated_at
}

entity "Позиция заказа" as order_items {
  * id
  --
  order_id
  product_id
  quantity
  price_at_purchase
}

entity "Отзыв" as reviews {
  * id
  --
  user_id
  product_id
  rating
  comment
  created_at
}

entity "История цен" as product_price_history {
  * id
  --
  product_id
  old_price
  new_price
  changed_at
  changed_by
}

users ||--o| sellers : "имеет профиль"
users ||--o{ orders : "оформляет"
users ||--o{ addresses : "имеет"
users ||--o{ reviews : "оставляет"

sellers ||--o{ products : "владеет"
sellers ||--o{ orders : "обрабатывает"

products ||--o{ product_categories : "связан"
categories ||--o{ product_categories : "содержит"
categories |o--o{ categories : "родительская"

products ||--o{ reviews : "получает"
products ||--o{ product_price_history : "имеет историю"
products ||--o{ order_items : "включён"

orders ||--o{ order_items : "содержит"
orders }o--o| addresses : "доставляется на"

note right of products
  reserved_quantity показывает количество,
  зарезервированное в pending-заказах.
  Инвариант БД:
  reserved_quantity <= stock_quantity
end note

note right of reviews
  Уникальность:
  один пользователь может оставить
  один отзыв на один товар.
end note

note right of orders
  status: draft, pending, paid,
  shipped, delivered, cancelled.
  seller_id и address_id могут отсутствовать
  на промежуточных этапах корзины/заказа.
end note

@enduml

@startuml C4_L4_Repository
title Компонент доступа к данным — PostgreSQL и MongoDB repositories (C4 L4)

skinparam classAttributeIconSize 0
left to right direction

package "component/repository" {
    class RepositoryComponent as "Component" {
        +User: UserRepo
        +Seller: SellerRepo
        +Address: AddressRepo
        +Review: ReviewRepo
        +ReviewPurchase: ReviewPurchaseChecker
        +Product: ProductRepo
        +Order: OrderRepo
        +OrderItem: OrderItemRepo
        +Category: CategoryRepo
        +Backoffice: BackofficeRepo
        +Favorite: FavoriteRepo
        +TxManager: TxManager
        -closeFn: func()
        +Close(): void
    }
}

package "repository (PostgreSQL)" {
    class UserRepoImpl {
        -pool: *pgxpool.Pool
    }
    class SellerRepoImpl {
        -pool: *pgxpool.Pool
    }
    class AddressRepoImpl {
        -pool: *pgxpool.Pool
    }
    class ReviewRepoImpl {
        -pool: *pgxpool.Pool
    }
    class ProductRepoImpl {
        -pool: *pgxpool.Pool
    }
    class OrderRepoImpl {
        -pool: *pgxpool.Pool
    }
    class OrderItemRepoImpl {
        -pool: *pgxpool.Pool
    }
    class CategoryRepoImpl {
        -pool: *pgxpool.Pool
    }
    class BackofficeRepoImpl {
        -pool: *pgxpool.Pool
        +GetAdminOrders(ctx, opts): []Order, error
        +GetPlatformStats(ctx): PlatformStats, error
    }
    class FavoriteRepoImpl {
        -pool: *pgxpool.Pool
    }
    class PgxTxManager {
        -pool: *pgxpool.Pool
        +WithTransaction(ctx, fn): error
    }

    interface DBTX {
        +Exec(ctx, sql, args): CommandTag, error
        +Query(ctx, sql, args): Rows, error
        +QueryRow(ctx, sql, args): Row
    }
}

package "repository/mongo" {
    class MongoStore as "Store" {
        -client: *mongo.Client
        -db: *mongo.Database
        +EnsureIndexes(ctx): error
        +WithTransaction(ctx, fn): error
    }
    class MongoDocuments as "BSON documents" {
        userDoc
        sellerDoc
        productDoc
        orderDoc
        orderItemDoc
        reviewDoc
        favoriteDoc
    }
}

package "service interfaces" {
    interface UserRepo {
        +GetUsers(ctx, opts): []User, error
        +GetUserByID(ctx, id): User, error
        +GetUserByEmail(ctx, email): User, error
        +CreateUser(ctx, uc): int64, error
        +UpdateUser(ctx, id, uu): User, error
        +ChangePasswordUser(ctx, id, hash): error
        +DeleteUserByID(ctx, id): error
    }
    interface SellerRepo {
        +GetSellerByID(ctx, id): Seller, error
        +GetSellerByUserID(ctx, userID): Seller, error
        +GetSellerStats(ctx, sellerID, from, to): SellerStats, error
        +CreateSeller(ctx, sc): int64, error
        +UpdateSeller(ctx, id, su): Seller, error
        +DeleteSellerByID(ctx, id): error
    }
    interface SellerGetter {
        +GetSellerByUserID(ctx, userID): Seller, error
    }
    interface AddressRepo {
        +GetAddressesByUserID(ctx, userID): []Address, error
        +CreateAddress(ctx, ac): int64, error
        +UpdateAddress(ctx, id, au): Address, error
        +DeleteAddressByID(ctx, id): error
    }
    interface ReviewRepo {
        +GetReviewByID(ctx, id): Review, error
        +GetReviewsByProductID(ctx, productID, opts): []Review, error
        +CreateReview(ctx, rc): int64, error
        +UpdateReview(ctx, id, ru): Review, error
        +DeleteReviewByID(ctx, id): error
    }
    interface ReviewPurchaseChecker {
        +HasPurchasedProduct(ctx, userID, productID): bool, error
    }
    interface ProductRepo {
        +GetProducts(ctx, opts): []Product, error
        +GetProductByID(ctx, id): Product, error
        +GetProductByIDForUpdate(ctx, id): Product, error
        +GetProductPriceHistory(ctx, productID, from, to): []ProductPriceHistory, error
        +CreateProduct(ctx, pc): int64, error
        +UpdateProduct(ctx, id, pu): Product, error
        +ChangeStockAndReserved(ctx, productID, stockDelta, reservedDelta): error
        +DeleteProductByID(ctx, id): error
    }
    interface OrderRepo {
        +GetOrderByID(ctx, id): Order, error
        +GetOrdersByUserID(ctx, userID, pg): []Order, error
        +GetSellerOrdersBySellerID(ctx, sellerID, pg): []Order, error
        +GetExpiredPendingOrders(ctx, deadline): []Order, error
        +CreateOrder(ctx, oc): int64, error
        +UpdateOrder(ctx, id, ou): Order, error
        +UpdateOrderStatus(ctx, id, from, to): error
        +LockUserCart(ctx, userID): error
        +DeleteOrderByID(ctx, id): error
    }
    interface OrderItemRepo {
        +GetOrderItemByID(ctx, id): OrderItem, error
        +GetOrderItemsByOrderID(ctx, orderID): []OrderItem, error
        +CreateOrderItem(ctx, oic): int64, error
        +UpdateOrderItem(ctx, id, oiu): OrderItem, error
        +UpdateOrderItemQtyIfDraft(ctx, id, userID, qty): error
        +DeleteOrderItemByID(ctx, id): error
        +DeleteOrderItemIfDraft(ctx, id, userID): error
    }
    interface CategoryRepo {
        +GetCategories(ctx, opts): []Category, error
        +GetCategoryByID(ctx, id): Category, error
        +CreateCategory(ctx, cc): int64, error
        +UpdateCategory(ctx, id, cu): Category, error
        +DeleteCategoryByID(ctx, id): error
    }
    interface BackofficeRepo {
        +GetAdminOrders(ctx, opts): []Order, error
        +GetPlatformStats(ctx): PlatformStats, error
    }
    interface FavoriteRepo {
        +AddFavorite(ctx, userID, productID): bool, error
        +DeleteFavorite(ctx, userID, productID): error
        +ListFavoriteProductsByUserID(ctx, userID, opts): []Product, error
        +IsFavorite(ctx, userID, productID): bool, error
    }
    interface TxManager {
        +WithTransaction(ctx, fn): error
    }
}

package "repository rows" {
    class userRow {
        +toModel(): User
    }
    class sellerRow {
        +toModel(): Seller
    }
    class sellerStatsRow {
        +toModel(): SellerStats
    }
    class addressRow {
        +toModel(): Address
    }
    class reviewRow {
        +toModel(): Review
    }
    class productRow {
        +toModel(): Product
    }
    class productPriceHistoryRow {
        +toModel(): ProductPriceHistory
    }
    class orderRow {
        +toModel(): Order
    }
    class orderItemRow {
        +toModel(): OrderItem
    }
    class categoryRow {
        +toModel(): Category
    }
    class favoriteProductRow {
        +toModel(): Product
    }
}


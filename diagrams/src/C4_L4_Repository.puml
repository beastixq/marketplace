UserRepoImpl ..> DBTX : getConn(ctx)
SellerRepoImpl ..> DBTX : getConn(ctx)
AddressRepoImpl ..> DBTX : getConn(ctx)
ReviewRepoImpl ..> DBTX : getConn(ctx)
ProductRepoImpl ..> DBTX : getConn(ctx)
OrderRepoImpl ..> DBTX : getConn(ctx)
OrderItemRepoImpl ..> DBTX : getConn(ctx)

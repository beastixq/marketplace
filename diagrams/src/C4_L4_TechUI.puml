@startuml C4_L4_TechUI
title Компонент технологического UI — пакет techui (C4 L4)

skinparam classAttributeIconSize 0
left to right direction

package "cmd/techui" {
    class main {
        +main(): void
    }
}

package "techui" {
    class App {
        -servicePorts: ServicePorts
        -in: *bufio.Reader
        -out: io.Writer
        -token: string
        -claims: *TokenClaims
        +Run(ctx): error
    }

    class ServicePorts {
        +Auth: AuthSession
        +UserProfile: UserProfile
        +UserAdministration: UserAdministration
        +SellerProfile: SellerProfile
        +SellerStatistics: SellerStatistics
        +ProductCatalog: ProductCatalog
        +ProductDetails: ProductDetails
        +ProductManagement: ProductManagement
        +CategoryBrowser: CategoryBrowser
        +CategoryManagement: CategoryManagement
        +AddressBook: AddressBook
        +Cart: Cart
        +BuyerOrders: BuyerOrders
        +SellerOrders: SellerOrders
        +Payments: Payments
        +ReviewManagement: ReviewManagement
    }

    interface AuthSession
    interface UserProfile
    interface UserAdministration
    interface SellerProfile
    interface SellerStatistics
    interface ProductCatalog
    interface ProductDetails
    interface ProductManagement
    interface CategoryBrowser
    interface CategoryManagement
    interface AddressBook
    interface Cart
    interface BuyerOrders
    interface SellerOrders
    interface Payments
    interface ReviewManagement
}

package "service" {
    class AuthServiceImpl as "AuthService"
    class UserServiceImpl as "UserService"
    class SellerServiceImpl as "SellerService"
    class ProductServiceImpl as "ProductService"
    class CategoryServiceImpl as "CategoryService"
    class AddressServiceImpl as "AddressService"
    class OrderServiceImpl as "OrderService"
    class PaymentServiceImpl as "PaymentService"
    class ReviewServiceImpl as "ReviewService"
}

package "repository" {
    class UserRepoImpl
    class SellerRepoImpl
    class ProductRepoImpl
    class CategoryRepoImpl
    class AddressRepoImpl
    class OrderRepoImpl
    class OrderItemRepoImpl
    class ReviewRepoImpl
    class PgxTxManager
}

main ..> App : создает
main ..> ServicePorts : внедряет зависимости
App o--> ServicePorts : агрегация

ServicePorts o--> AuthSession
ServicePorts o--> UserProfile
ServicePorts o--> UserAdministration
ServicePorts o--> SellerProfile
ServicePorts o--> SellerStatistics
ServicePorts o--> ProductCatalog
ServicePorts o--> ProductDetails
ServicePorts o--> ProductManagement
ServicePorts o--> CategoryBrowser
ServicePorts o--> CategoryManagement
ServicePorts o--> AddressBook
ServicePorts o--> Cart
ServicePorts o--> BuyerOrders
ServicePorts o--> SellerOrders
ServicePorts o--> Payments
ServicePorts o--> ReviewManagement

AuthSession <|.. AuthServiceImpl
UserProfile <|.. UserServiceImpl
UserAdministration <|.. UserServiceImpl
SellerProfile <|.. SellerServiceImpl
SellerStatistics <|.. SellerServiceImpl
ProductCatalog <|.. ProductServiceImpl
ProductDetails <|.. ProductServiceImpl
ProductManagement <|.. ProductServiceImpl
CategoryBrowser <|.. CategoryServiceImpl
CategoryManagement <|.. CategoryServiceImpl
AddressBook <|.. AddressServiceImpl
Cart <|.. OrderServiceImpl
BuyerOrders <|.. OrderServiceImpl
SellerOrders <|.. OrderServiceImpl
Payments <|.. PaymentServiceImpl
ReviewManagement <|.. ReviewServiceImpl

AuthServiceImpl o--> UserServiceImpl
UserServiceImpl o--> UserRepoImpl
SellerServiceImpl o--> SellerRepoImpl
ProductServiceImpl o--> ProductRepoImpl
ProductServiceImpl o--> ReviewRepoImpl
ProductServiceImpl o--> SellerRepoImpl
CategoryServiceImpl o--> CategoryRepoImpl
AddressServiceImpl o--> AddressRepoImpl
OrderServiceImpl o--> OrderRepoImpl
OrderServiceImpl o--> OrderItemRepoImpl
OrderServiceImpl o--> ProductRepoImpl
OrderServiceImpl o--> SellerRepoImpl
OrderServiceImpl o--> PgxTxManager
PaymentServiceImpl o--> OrderRepoImpl
ReviewServiceImpl o--> ReviewRepoImpl

note right of App
  Меню покрывают основные Use Case:
  регистрация/вход, каталог, корзина,
  оформление и оплата заказа, профиль
  продавца, товары, статистика, отзывы,
  адреса, категории и администрирование.
end note

@enduml

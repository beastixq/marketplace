@startuml C4_L4_TechUI
title Технологический UI и сборка компонентов — cmd/techui, component/techui, techui.App (C4 L4)

skinparam classAttributeIconSize 0
left to right direction

package "cmd/techui" {
    class TechUIMain as "main" {
        +main(): void
    }
}

package "config" {
    class Config {
        +Server: ServerConfig
        +Database: DatabaseConfig
        +Auth: AuthConfig
        +Payment: PaymentConfig
        +Orders: OrdersConfig
        +Logging: LoggingConfig
    }

    class ConfigLoader as "Load" {
        +Load(path string): *Config, error
    }
}

package "logging" {
    class LoggerFactory as "New" {
        +New(cfg LoggingConfig): *slog.Logger, io.Closer, error
    }
}

package "component/repository" {
    class RepositoryComponent as "Component" {
        +Pool: *pgxpool.Pool
        +User: UserRepo
        +Seller: SellerRepo
        +Address: AddressRepo
        +Review: ReviewRepo
        +Product: ProductRepo
        +Order: OrderRepo
        +OrderItem: OrderItemRepo
        +Category: CategoryRepo
        +TxManager: TxManager
        +Close(): void
    }
}

package "component/service" {
    class ServiceComponent as "Component" {
        +User: UserService
        +Seller: SellerService
        +Address: AddressService
        +Review: ReviewService
        +Product: ProductService
        +Order: OrderService
        +Category: CategoryService
        +Auth: AuthService
        +Payment: *PaymentService
    }

    class ServiceConfig as "Config" {
        +BcryptCost: int
        +JWTSecret: string
        +TokenTTL: time.Duration
        +PaymentTTL: time.Duration
        +PaymentGatewayBaseURL: string
        +TokenBlocklist: TokenBlocklist
    }
}

package "component/techui" {
    class TechUIComponent as "Component" {
        -app: *techui.App
        +Run(ctx): error
    }
}

package "techui" {
    class App {
        -servicePorts: ServicePorts
        -in: *bufio.Reader
        -out: io.Writer
        -token: string
        -claims: *TokenClaims
        -logger: *slog.Logger
        +Run(ctx): error
        -run(ctx, fn): void
        -actionName(fn): string
    }

    class ServicePorts {
        +Auth: AuthSession
        +UserProfile: UserProfile
        +UserAdministration: UserAdministration
        +SellerProfile: SellerProfile
        +SellerStatistics: SellerStatistics
        +ProductCatalog: ProductCatalog
        +ProductDetails: ProductDetails
        +ProductManagement: ProductManagement
        +CategoryBrowser: CategoryBrowser
        +CategoryManagement: CategoryManagement
        +AddressBook: AddressBook
        +Cart: Cart
        +BuyerOrders: BuyerOrders
        +SellerOrders: SellerOrders
        +Payments: Payments
        +ReviewManagement: ReviewManagement
    }

    interface AuthSession
    interface UserProfile
    interface UserAdministration
    interface SellerProfile
    interface SellerStatistics
    interface ProductCatalog
    interface ProductDetails
    interface ProductManagement
    interface CategoryBrowser
    interface CategoryManagement
    interface AddressBook
    interface Cart
    interface BuyerOrders
    interface SellerOrders
    interface Payments
    interface ReviewManagement
}

package "service" {
    class AuthService
    class UserService
    class SellerService
    class ProductService
    class CategoryService
    class AddressService
    class OrderService
    class PaymentService
    class ReviewService
}

TechUIMain ..> ConfigLoader : читает -config
TechUIMain ..> LoggerFactory : создаёт root logger
TechUIMain ..> RepositoryComponent : создаёт компонент доступа к данным
TechUIMain ..> ServiceConfig : формирует из Config
TechUIMain ..> ServiceComponent : создаёт компонент бизнес-логики
TechUIMain ..> TechUIComponent : создаёт компонент UI
TechUIMain ..> App : запускает Run

ConfigLoader ..> Config : возвращает
LoggerFactory ..> App : передаёт *slog.Logger
RepositoryComponent --> ServiceComponent : repositories + TxManager
ServiceConfig --> ServiceComponent : параметры auth/payment
ServiceComponent --> TechUIComponent : services
TechUIComponent *-- App : владеет
App o-- ServicePorts : вызывает use cases через порты

ServicePorts o--> AuthSession
ServicePorts o--> UserProfile
ServicePorts o--> UserAdministration
ServicePorts o--> SellerProfile
ServicePorts o--> SellerStatistics
ServicePorts o--> ProductCatalog
ServicePorts o--> ProductDetails
ServicePorts o--> ProductManagement
ServicePorts o--> CategoryBrowser
ServicePorts o--> CategoryManagement
ServicePorts o--> AddressBook
ServicePorts o--> Cart
ServicePorts o--> BuyerOrders
ServicePorts o--> SellerOrders
ServicePorts o--> Payments
ServicePorts o--> ReviewManagement

AuthSession <|.. AuthService
UserProfile <|.. UserService
UserAdministration <|.. UserService
SellerProfile <|.. SellerService
SellerStatistics <|.. SellerService
ProductCatalog <|.. ProductService
ProductDetails <|.. ProductService
ProductManagement <|.. ProductService
CategoryBrowser <|.. CategoryService
CategoryManagement <|.. CategoryService
AddressBook <|.. AddressService
Cart <|.. OrderService
BuyerOrders <|.. OrderService
SellerOrders <|.. OrderService
Payments <|.. PaymentService
ReviewManagement <|.. ReviewService

note right of App
  TechUI не использует HTTP middleware:
  ввод идёт через stdin, вывод через stdout.
  Поэтому действия пользователя логируются
  в App.run, где известны command name,
  user_id, role, duration и error.
end note

note bottom of TechUIMain
  cmd/techui является точкой сборки:
  он связывает repository, service и techui
  в единое запускаемое приложение.
end note

@enduml

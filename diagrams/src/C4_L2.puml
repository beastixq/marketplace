@startuml C4_L2
!include <C4/C4_Container>

title Онлайн-маркетплейс — Контейнеры (C4 L2)

Person(webUser, "Пользователь", "Гость, Покупатель, Продавец,\nАдминистратор, Аналитик")

System_Ext(bank, "Mock Bank", "Платёжный контур / имитация банка")

System_Boundary(marketplace, "Онлайн-маркетплейс") {
    Container(api, "HTTP/Web приложение", "Go 1.24+, chi, html/template, slog", "REST API и текущий web_handler;\nчитает YAML config, пишет структурированные логи;\nполноценный Web GUI планируется доработать в ЛР7")
    Container(techui, "Технологический UI", "Go 1.24+, console, slog", "Интерактивное консольное приложение\nдля проверки Use Case без HTTP;\nчитает YAML config, пишет действия пользователя в лог")
    Container(seed, "Seed утилита", "Go 1.24+, go-faker", "Генерация тестовых данных для БД")
    ContainerDb(postgres, "База данных", "PostgreSQL 16", "Пользователи, продавцы, товары,\nзаказы, позиции заказов, адреса, отзывы,\nкатегории и история цен")
}

Rel(webUser, api, "Работает через Web GUI / REST API", "HTTPS")
Rel(webUser, techui, "Выполняет сценарии через консольный UI", "terminal")

Rel(api, postgres, "Читает и изменяет данные", "pgx/v5")
Rel(techui, postgres, "Работает с данными через service/repository", "pgx/v5")
Rel(seed, postgres, "Записывает тестовые данные", "pgx/v5")

Rel(api, bank, "Запрашивает платёжную ссылку, принимает callback", "HTTP")
Rel(techui, bank, "Проверяет mock-платёж через PaymentService", "HTTP URL / token")

LAYOUT_WITH_LEGEND()

@enduml

@startuml C4_L2
!include <C4/C4_Container>

title Онлайн-маркетплейс — Контейнеры (C4 L2)

Person(webUser, "Пользователь", "Гость, Покупатель, Продавец,\nАдминистратор, Аналитик")

System_Boundary(marketplace, "Онлайн-маркетплейс") {
    Container(api, "HTTP/Web приложение", "Go 1.25+, chi, html/template, slog", "REST API, серверный Web GUI и встроенный Mock Bank;\nчитает YAML config, пишет структурированные логи")
    Container(techui, "Технологический UI", "Go 1.25+, console, slog", "Интерактивное консольное приложение\nдля проверки Use Case без HTTP;\nчитает YAML config, пишет действия пользователя в лог")
    Container(seed, "Seed утилита", "Go 1.25+, go-faker", "Генерация тестовых данных для БД")
    ContainerDb(postgres, "База данных", "PostgreSQL 16", "Пользователи, продавцы, товары,\nзаказы, позиции заказов, адреса, отзывы,\nкатегории и история цен")
    ContainerDb(redis, "Кэш товаров", "Redis 8", "Опциональный кэш products:{id}")
}

Rel(webUser, api, "Работает через Web GUI / REST API", "HTTP (локально)")
Rel(webUser, techui, "Выполняет сценарии через консольный UI", "terminal")

Rel(api, postgres, "Читает и изменяет данные", "pgx/v5")
Rel(api, redis, "Кэширует чтение товара по ID при включённом Redis", "go-redis/v9")
Rel(techui, postgres, "Работает с данными через service/repository", "pgx/v5")
Rel(seed, postgres, "Записывает тестовые данные", "pgx/v5")


LAYOUT_WITH_LEGEND()

@enduml

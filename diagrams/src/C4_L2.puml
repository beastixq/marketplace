@startuml C4_L2
!include <C4/C4_Container>

title Онлайн-маркетплейс — Контейнеры (C4 L2)

Person(user, "Пользователь", "Гость, Покупатель, Продавец,\nАдминистратор, Аналитик")

System_Ext(bank, "Платёжная система", "Обрабатывает платежи")

System_Boundary(marketplace, "Онлайн-маркетплейс") {
    Container(webapp, "Веб-приложение", "Go 1.24+, chi, html/template", "Обрабатывает HTTP-запросы,\nрендерит HTML-страницы,\nреализует бизнес-логику")
    Container(techui, "Технологический UI", "Go 1.24+, console", "Интерактивное консольное приложение\nдля системного тестирования Use Case")
    ContainerDb(postgres, "База данных", "PostgreSQL 16", "Хранит пользователей, товары,\nзаказы, отзывы")
    ContainerDb(redis, "Кэш", "Redis 7", "Кэширует каталог и карточки товаров,\nхранит блок-лист отозванных JWT-токенов")
}

Rel(user, webapp, "Использует", "HTTPS")
Rel(user, techui, "Запускает", "terminal")
Rel(webapp, postgres, "Читает и записывает данные", "pgx/v5")
Rel(webapp, redis, "Кэширует данные, проверяет блок-лист токенов", "go-redis/v9")
Rel(webapp, bank, "Инициирует платёж", "HTTPS")
Rel(techui, postgres, "Читает и записывает данные через тот же service/repository", "pgx/v5")
Rel(techui, bank, "Инициирует mock-платёж через PaymentService", "in-process adapter")

LAYOUT_WITH_LEGEND()

@enduml

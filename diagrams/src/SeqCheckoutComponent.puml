@startuml SeqCheckoutComponent
title Оформление заказа (Checkout) — диаграмма последовательностей (уровень компонентов)

skinparam responseMessageBelowArrow true

actor "Покупатель" as buyer

box "Веб-приложение (Go, chi)" #E8F4FD
    participant "OrderHandler" as handler
    participant "OrderService" as svc
    participant "OrderRepo" as orderRepo
    participant "OrderItemRepo" as itemRepo
    participant "ProductRepo" as productRepo
end box

database "PostgreSQL" as db

== Добавление товаров в корзину ==

loop пока покупатель добавляет товары
    buyer -> handler : POST /cart/items {product_id, qty}
    activate handler

    handler -> handler : validate request

    handler -> svc : AddItemToCart(ctx, userID, productID, qty)
    activate svc

    svc -> svc : GetCart(ctx, userID)
    note right : поиск draft-заказа\nсреди заказов пользователя

    svc -> orderRepo : GetOrdersByUserID(ctx, userID)
    activate orderRepo
    orderRepo -> db : SELECT * FROM orders WHERE user_id = $1
    db --> orderRepo : rows
    orderRepo --> svc : []Order
    deactivate orderRepo

    svc -> svc : фильтрация status = 'draft',\nвыбор последнего по дате

    opt корзина не найдена
        svc -> orderRepo : CreateOrder(ctx, {userID, draft, 0})
        activate orderRepo
        orderRepo -> db : INSERT INTO orders (status='draft')
        db --> orderRepo : cartID
        orderRepo --> svc : cartID
        deactivate orderRepo
    end

    svc -> productRepo : GetProductByID(ctx, productID)
    activate productRepo
    productRepo -> db : SELECT * FROM products WHERE id = $1
    db --> productRepo : row
    productRepo --> svc : Product
    deactivate productRepo

    break qty > product.StockQuantity
        svc --> handler : ErrQuantityTooBig
        handler --> buyer : 400 Bad Request
    end

    svc -> itemRepo : CreateOrderItem(ctx, {cartID, productID, qty, price})
    activate itemRepo
    itemRepo -> db : INSERT INTO order_items
    db --> itemRepo : id
    itemRepo --> svc : id
    deactivate itemRepo

    svc --> handler : nil
    deactivate svc

    handler --> buyer : 204 No Content
    deactivate handler
end

== Оформление заказа (Checkout) ==

buyer -> handler : POST /api/v1/orders {address_id}
activate handler

handler -> handler : extract claims, validate address_id

handler -> svc : Checkout(ctx, userID, addressID)
activate svc

svc -> svc : GetCart(ctx, userID)

svc -> orderRepo : GetOrdersByUserID(ctx, userID)
activate orderRepo
orderRepo -> db : SELECT * FROM orders WHERE user_id = $1
db --> orderRepo : rows
orderRepo --> svc : []Order
deactivate orderRepo

svc -> svc : фильтрация status = 'draft'

break корзина не найдена
    svc --> handler : ErrCartNotFound
    handler --> buyer : 404 Not Found
end

svc -> itemRepo : GetOrderItemsByOrderID(ctx, cart.ID)
activate itemRepo
itemRepo -> db : SELECT * FROM order_items WHERE order_id = $1
db --> itemRepo : rows
itemRepo --> svc : []OrderItem
deactivate itemRepo

break корзина пуста
    svc --> handler : ErrEmptyCart
    handler --> buyer : 400 Bad Request
end

loop для каждой позиции корзины
    svc -> productRepo : GetProductByID(ctx, item.ProductID)
    activate productRepo
    productRepo -> db : SELECT * FROM products WHERE id = $1
    db --> productRepo : row
    productRepo --> svc : Product
    deactivate productRepo

    svc -> svc : группировка по product.SellerID
end

loop для каждого продавца (sellerID)
    svc -> svc : подсчёт totalAmount\nпо позициям продавца

    svc -> orderRepo : CreateOrder(ctx, {userID, addressID,\nsellerID, pending, totalAmount})
    activate orderRepo
    orderRepo -> db : INSERT INTO orders\n(status='pending', seller_id, total_amount)
    db --> orderRepo : orderID
    orderRepo --> svc : orderID
    deactivate orderRepo

    loop для каждой позиции этого продавца
        svc -> itemRepo : CreateOrderItem(ctx,\n{orderID, productID, qty, priceAtPurchase})
        activate itemRepo
        itemRepo -> db : INSERT INTO order_items
        db --> itemRepo : id
        itemRepo --> svc : id
        deactivate itemRepo
    end
end

svc -> orderRepo : DeleteOrderByID(ctx, cart.ID)
activate orderRepo
orderRepo -> db : DELETE FROM orders WHERE id = $1
db --> orderRepo : ok
orderRepo --> svc : nil
deactivate orderRepo

svc --> handler : []orderIDs
deactivate svc

handler -> handler : конвертация в DTO

handler --> buyer : 201 Created {order_ids: [...]}
deactivate handler

== Оплата заказа ==

buyer -> handler : POST /api/v1/orders/:id/pay
activate handler

handler -> handler : extract claims, parse orderID

handler -> svc : PayOrder(ctx, orderID, userID)
activate svc

svc -> orderRepo : GetOrderByID(ctx, orderID)
activate orderRepo
orderRepo -> db : SELECT * FROM orders WHERE id = $1
db --> orderRepo : row
orderRepo --> svc : Order
deactivate orderRepo

break заказ не найден
    svc --> handler : ErrOrderNotFound
    handler --> buyer : 404 Not Found
end

break userID != order.UserID
    svc --> handler : ErrNotYourOrder
    handler --> buyer : 403 Forbidden
end

break status != 'pending'
    svc --> handler : ErrOrderStatusInvalid
    handler --> buyer : 409 Conflict
end

svc -> orderRepo : UpdateOrder(ctx, orderID, {status: paid})
activate orderRepo
orderRepo -> db : UPDATE orders SET status='paid'\nWHERE id = $1
db --> orderRepo : Order
orderRepo --> svc : Order
deactivate orderRepo

svc --> handler : nil
deactivate svc

handler --> buyer : 204 No Content
deactivate handler

@enduml

@startuml SeqCheckout
title Оформление заказа — текущая реализация

skinparam responseMessageBelowArrow true
skinparam maxMessageSize 280
skinparam sequenceMessageAlign center

actor "Покупатель" as buyer
box "Один Go HTTP-процесс" #E8F4FD
    participant "HTTP API\nOrderHandler" as api
    participant "OrderService" as orders
    participant "PgxTxManager" as tx
    participant "OrderRepo /\nOrderItemRepo" as storage
    participant "AddressRepo" as addresses
    participant "ProductRepo" as products
end box
database "PostgreSQL" as db

note over api, orders
  Маршрут защищён JWT и ролью buyer в middleware;
  обработчик разбирает DTO, сервис получает Actor.
  SQL выполняют реализации репозиториев, не обработчик.
  OrderRepo / OrderItemRepo сгруппированы на одной линии.
end note

== Оформление заказа: одна транзакция ==

buyer -> api : POST /api/v1/orders\n{address_id}
api -> api : Checkout: разобрать JSON;\nпроверить address_id > 0
api -> orders : Checkout(ctx, actor, addressID)
orders -> orders : Проверить роль buyer
orders -> tx : WithTransaction(ctx, fn)
tx -> db : BEGIN
tx -> orders : fn(ctx с pgx.Tx)

alt Все проверки и записи fn успешны
    orders -> storage : OrderRepo.LockUserCart(ctx, actor.UserID)
    storage -> db : pg_advisory_xact_lock(cartLockKey)
    orders -> addresses : GetAddressByID(ctx, addressID)
    addresses --> orders : Address
    orders -> orders : address.UserID == actor.UserID

    orders -> orders : GetCart(ctx, actor)
    orders -> storage : OrderRepo.GetOrdersByUserID(ctx,\nactor.UserID, PaginationOpts{})
    storage --> orders : []Order
    orders -> orders : Найти последний draft
    orders -> storage : OrderItemRepo.GetOrderItemsByOrderID(ctx, cart.ID)
    storage --> orders : []OrderItem для суммы draft

    orders -> storage : OrderRepo.UpdateOrderStatus(ctx,\ncart.ID, {draft}, pending)
    storage -> db : UPDATE orders WHERE id = cart.ID\nAND status = draft -> pending
    storage --> orders : nil; 0 изменённых строк -> ErrNotFound
    orders -> storage : OrderItemRepo.GetOrderItemsByOrderID(ctx, cart.ID)
    storage --> orders : []OrderItem после захвата корзины
    orders -> orders : Проверить непустую корзину;\nсуммировать qty по productID;\nотсортировать productID

    loop Каждый productID по возрастанию
        orders -> products : GetProductByIDForUpdate(ctx, productID)
        products -> db : SELECT product FOR UPDATE
        products --> orders : Product
        orders -> orders : Проверить DeletedAt и\nstock_quantity - reserved_quantity >= qty
        orders -> products : ChangeStockAndReserved(ctx,\nproductID, 0, +qty)
        products -> db : UPDATE products:\nreserved_quantity += qty
    end

    orders -> orders : price_at_purchase = текущая product.Price;\nгруппировать позиции по SellerID

    alt Один продавец
        loop Каждая позиция корзины
            orders -> storage : OrderItemRepo.UpdateOrderItem(ctx,\nitem.ID, {PriceAtPurchase})
        end
        orders -> orders : total = сумма quantity * price_at_purchase
        orders -> storage : OrderRepo.UpdateOrder(ctx, cart.ID,\n{SellerID, AddressID, TotalAmount})
        orders -> orders : orderIDs = [cart.ID]
        note over orders, storage
          pending-заказ сохраняет cart.ID и created_at.
          Исходная строка корзины не удаляется.
        end note
    else Несколько продавцов
        loop Каждый продавец
            orders -> orders : Сумма позиций этого продавца
            orders -> storage : OrderRepo.CreateOrder(ctx,\n{UserID, AddressID, SellerID, pending, TotalAmount})
            storage --> orders : orderID
            loop Каждая позиция продавца
                orders -> storage : OrderItemRepo.CreateOrderItem(ctx,\n{orderID, ProductID, Quantity, PriceAtPurchase})
            end
        end
        orders -> storage : OrderRepo.DeleteOrderByID(ctx, cart.ID)
        storage -> db : DELETE исходного draft;\nпозиции удаляются через ON DELETE CASCADE
    end

    orders --> tx : fn возвращает nil
    tx -> db : COMMIT
    db --> tx : Успешный COMMIT
    tx --> orders : nil
    orders --> api : orderIDs, nil
    api --> buyer : 201 Created\n{order_ids: [...]}

else Первая ошибка проверки или записи в fn
    ref over orders, db
      Выполнение до первой ошибки, остальные шаги пропускаются:
      нет/чужой адрес; нет draft; захват проиграл;
      пустая корзина; нет/удалённый товар; недостаточный остаток;
      ошибка репозитория при чтении/резерве/сохранении.
    end ref
    orders --> tx : fn возвращает ошибку
    tx -> db : ROLLBACK всей транзакции
    tx --> orders : ошибка
    orders --> api : nil, ошибка
    api --> buyer : writeServiceError:\n400 / 403 / 404 / 409 / 500 {error}
    note over orders, db
      Нет частично оформленных заказов и частичного резерва;
      изменения этой транзакции отменены.
      Ошибка BEGIN/COMMIT также не даёт 201.
    end note
end

@enduml

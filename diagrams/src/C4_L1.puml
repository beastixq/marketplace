Rel(analyst, marketplace, "Просматривает аналитические отчёты", "HTTPS / Web GUI")
Rel(marketplace, bank, "Запрашивает платёжную ссылку и обрабатывает callback", "HTTP")

LAYOUT_WITH_LEGEND()


System(marketplace, "Онлайн-маркетплейс", "Платформа, на которой продавцы размещают товары, а покупатели выбирают, заказывают, оплачивают и оценивают покупки")

System_Ext(bank, "Mock Bank", "Внешний платёжный контур / имитация банка для получения и обработки платежей")


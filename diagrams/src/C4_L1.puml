@startuml C4_L1
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()

title Онлайн-маркетплейс — Контекст системы (C4 L1)

Person(guest, "Гость", "Просматривает каталог и историю цен")
Person(buyer, "Покупатель", "Оформляет заказы, оставляет отзывы")
Person(seller, "Продавец", "Управляет товарами, отслеживает продажи")
Person(admin, "Администратор / модератор", "Модерирует пользователей, товары, отзывы и категории")
Person(analyst, "Аналитик", "Формирует аналитические отчёты")

System(marketplace, "Онлайн-маркетплейс", "Платформа, на которой продавцы размещают товары, а покупатели выбирают, заказывают, оплачивают и оценивают покупки")

Rel(guest, marketplace, "Просматривает каталог и карточки товаров", "HTTP / Web GUI (локально)")
Rel(buyer, marketplace, "Управляет корзиной, оформляет и оплачивает заказы", "HTTP / Web GUI (локально)")
Rel(seller, marketplace, "Управляет товарами и заказами продавца", "HTTP / Web GUI (локально)")
Rel(admin, marketplace, "Модерирует пользователей, товары, отзывы и категории", "HTTP / Web GUI (локально)")
Rel(analyst, marketplace, "Просматривает аналитические отчёты", "HTTP / Web GUI (локально)")

LAYOUT_WITH_LEGEND()

@enduml

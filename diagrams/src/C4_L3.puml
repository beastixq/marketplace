@startuml C4_L3
!include <C4/C4_Component>

title Онлайн-маркетплейс — Компоненты приложения (C4 L3)

Person(user, "Пользователь", "Работает через Web/API")

Container_Boundary(api, "cmd/api — HTTP/Web приложение") {
    Component(apiMain, "cmd/api main", "Go", "Точка сборки: читает config,\nсоздаёт logger, pool, services и router")
    Component(router, "Router", "chi.Router", "Маршрутизирует REST API и Web GUI маршруты")
    Component(apiHandlers, "API Handlers", "Go, net/http", "Обрабатывают JSON/API запросы и переводят service errors в HTTP status")
    Component(webHandlers, "Web Handlers", "Go controller", "Контроллеры серверного Web GUI:\nчитают HTTP form/query, проверяют роль,\nвызывают service layer")
    Component(webTemplates, "HTML Templates", "html/template", "View layer для Web GUI:\nlayout и страницы каталога, профиля,\nadmin panel и analyst dashboard")
    Component(authMiddleware, "AuthMiddleware / RequireRole", "Go middleware", "Проверяет JWT и роли пользователя")
    Component(loggingMiddleware, "RequestLogger / Recoverer", "slog middleware", "Логирует HTTP-запросы,\nстатусы, данные actor и stack при panic")
}

Container_Boundary(techuiContainer, "cmd/techui — технологический UI") {
    Component(techuiMain, "cmd/techui main", "Go", "Точка сборки: читает config,\nсоздаёт logger и связывает компоненты")
    Component(techuiComponent, "component/techui", "Go facade", "Собирает TechUI App из ServicePorts")
    Component(techuiApp, "techui.App", "Go, console", "Меню, ввод/вывод, логирование конкретных команд пользователя")
}

Container_Boundary(seedContainer, "cmd/seed — генератор данных") {
    Component(seedMain, "cmd/seed main", "Go, go-faker", "Создаёт тестовые данные для БД")
}

Container_Boundary(serviceLayer, "Компонент бизнес-логики") {
    Component(serviceComponent, "component/service", "Go facade", "Создаёт и связывает Auth/User/Product/Order/... services")
    Component(domainServices, "Service package", "Go", "Бизнес-правила, RBAC, checkout,\nоплата, статусы заказов, отзывы, категории")
    Component(backofficeService, "BackofficeService", "Go", "Read-модели для admin panel и analyst dashboard")
    Component(paymentService, "PaymentService", "Go", "Формирует payment URL и обрабатывает результат оплаты")
    Component(paymentGateway, "MockBankGateway", "Go adapter", "Адаптер платёжного контура")
    Component(orderWorker, "OrderExpirationWorker", "Go goroutine", "Периодически отменяет просроченные заказы в status pending")
}

Container_Boundary(repositoryLayer, "Компонент доступа к данным") {
    Component(repositoryComponent, "component/repository", "Go facade", "Создаёт pgxpool, repositories и TxManager")
    Component(repositories, "Repository package", "Go, pgx/v5, squirrel", "SQL-запросы и преобразование rows -> model")
    Component(txManager, "PgxTxManager", "Go, pgx.Tx", "Единая граница транзакций для service layer")
}

ContainerDb(postgres, "База данных", "PostgreSQL 16", "")
System_Ext(bank, "Mock Bank", "HTTP payment mock")

Rel(user, router, "HTTP/Web requests", "HTTPS")
Rel(router, loggingMiddleware, "Оборачивает запросы", "middleware")
Rel(router, authMiddleware, "Защищает закрытые маршруты", "middleware")
Rel(router, apiHandlers, "Передаёт API requests", "net/http")
Rel(router, webHandlers, "Передаёт Web GUI requests", "net/http")

Rel(apiHandlers, domainServices, "Вызывает use cases", "интерфейсы service layer")
Rel(apiHandlers, paymentService, "Получает payment URL и обрабатывает callback", "Payments")
Rel(webHandlers, domainServices, "Вызывает use cases", "интерфейсы service layer")
Rel(webHandlers, paymentService, "Получает payment URL и обрабатывает mock bank result", "Payments")
Rel(webHandlers, backofficeService, "Получает admin/analytics read models", "BackofficeService")
Rel(webHandlers, webTemplates, "Рендерит HTML", "template data")
Rel(orderWorker, domainServices, "Отменяет просроченные заказы", "OrderExpirer")

Rel(user, techuiApp, "Команды технологического UI", "terminal")
Rel(techuiComponent, techuiApp, "Создаёт", "ServicePorts")
Rel(techuiApp, domainServices, "Вызывает use cases", "интерфейсы service layer")
Rel(techuiApp, paymentService, "Проверяет оплату", "Payments")
Rel(apiMain, orderWorker, "Запускает", "goroutine")
Rel(techuiMain, orderWorker, "Запускает", "goroutine")

Rel(serviceComponent, domainServices, "Создаёт services", "constructors")
Rel(serviceComponent, backofficeService, "Создаёт backoffice service", "constructor")
Rel(serviceComponent, paymentService, "Создаёт payment service", "constructor")
Rel(domainServices, repositories, "Читает/изменяет данные", "repository interfaces")
Rel(backofficeService, repositories, "Читает агрегаты и списки", "BackofficeRepo")
Rel(paymentService, repositories, "Читает/изменяет заказ", "OrderRepo")
Rel(domainServices, txManager, "Открывает транзакции", "TxManager")
Rel(paymentService, paymentGateway, "Запрашивает/обрабатывает оплату", "PaymentGateway")
Rel(paymentGateway, bank, "HTTP URL / token", "HTTP")

Rel(repositoryComponent, repositories, "Создаёт repositories", "constructors")
Rel(repositoryComponent, txManager, "Создаёт", "constructor")
Rel(repositories, postgres, "SQL", "pgx/v5")
Rel(txManager, postgres, "BEGIN / COMMIT / ROLLBACK", "pgx.Tx")

Rel(seedMain, postgres, "Записывает тестовые данные", "pgx/v5")

LAYOUT_WITH_LEGEND()

@enduml

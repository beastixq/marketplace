@startuml C4_L3
!include <C4/C4_Component>

title Онлайн-маркетплейс — Компоненты приложения (C4 L3)

Person(user, "Пользователь")

Container_Boundary(webapp, "Веб-приложение") {
    Component(handler, "Handler", "Go, chi, html/template", "HTTP-обработчики, рендеринг HTML-страниц")
    Component(techui, "TechUI", "Go, console", "Интерактивные меню и сценарии\nсистемного тестирования")
    Component(service, "Service", "Go", "Бизнес-логика приложения")
    Component(cache, "Cache Decorators", "Go, go-redis/v9", "Декораторы над репозиториями,\nпаттерн cache-aside (Product, Category)")
    Component(repository, "Repository", "Go, pgx/v5", "Доступ к данным PostgreSQL")
}

ContainerDb(postgres, "База данных", "PostgreSQL 16", "")
ContainerDb(redis, "Кэш", "Redis 7", "")

Rel(user, handler, "HTTP-запросы", "HTTPS")
Rel(user, techui, "Команды технологического UI", "terminal")
Rel(handler, service, "Вызывает", "интерфейс")
Rel(techui, service, "Вызывает", "интерфейсы сервисов")
Rel(service, cache, "Вызывает", "интерфейс ProductRepo, CategoryRepo")
Rel(service, repository, "Вызывает напрямую", "прочие интерфейсы")
Rel(cache, repository, "Делегирует (cache miss)", "интерфейс")
Rel(cache, redis, "GET / SET / DEL", "go-redis/v9")
Rel(repository, postgres, "SQL-запросы", "pgx/v5")

LAYOUT_WITH_LEGEND()

@enduml

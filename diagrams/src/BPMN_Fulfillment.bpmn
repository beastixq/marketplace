<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Fulfillment" targetNamespace="urn:marketplace:weblab1:fulfillment" exporter="marketplace diagram generator" exporterVersion="2.0.2">
  <bpmn:itemDefinition id="Item_OrderContext">
    <bpmn:documentation>Контекст выбранного заказа и инициатора запроса.</bpmn:documentation>
  </bpmn:itemDefinition>
  <bpmn:itemDefinition id="Item_ActionResult">
    <bpmn:documentation>Результат действия: success и описание отказа. Не внешний API-контракт.</bpmn:documentation>
  </bpmn:itemDefinition>
  <bpmn:message id="Request_Cancel" name="Request_Cancel" itemRef="Item_OrderContext" />
  <bpmn:message id="Request_Deliver" name="Request_Deliver" itemRef="Item_OrderContext" />
  <bpmn:message id="Request_Ship" name="Request_Ship" itemRef="Item_OrderContext" />
  <bpmn:message id="Response_Cancel" name="Response_Cancel" itemRef="Item_ActionResult" />
  <bpmn:message id="Response_Deliver" name="Response_Deliver" itemRef="Item_ActionResult" />
  <bpmn:message id="Response_Ship" name="Response_Ship" itemRef="Item_ActionResult" />
  <bpmn:dataStore id="Store_Orders" name="Заказы" isUnlimited="true" />
  <bpmn:dataStore id="Store_Products" name="Товары" isUnlimited="true" />
  <bpmn:collaboration id="Collaboration_Fulfillment">
    <bpmn:documentation>Исполнение оплаченного заказа. Три логических участника, не три сервиса. Покупатель запрашивает отмену до отправки; продавец запрашивает отправку и затем вручную выставляет delivered. Проверяются роль, владелец и исходный статус. Отправка/отмена меняют остатки/резерв в одной транзакции. Каждый запрос запускает отдельный экземпляр обработки в пуле маркетплейса. Ответ содержит успех или отказ; шлюзы проверяют результат действия, не физическую доставку. Отказ завершает попытку, не отменяет заказ. Сценарий начинается с paid; отмена pending вне этой диаграммы. Сообщения — запросы/ответы приложения, не очередь и не push-уведомления.</bpmn:documentation>
    <bpmn:participant id="Participant_seller" name="Продавец" processRef="Process_seller" />
    <bpmn:participant id="Participant_marketplace" name="Маркетплейс" processRef="Process_marketplace" />
    <bpmn:participant id="Participant_buyer" name="Покупатель" processRef="Process_buyer" />
    <bpmn:messageFlow id="Message_Request_ship" sourceRef="send_ship" targetRef="start_ship" messageRef="Request_Ship" />
    <bpmn:messageFlow id="Message_Response_ship" sourceRef="result_ship" targetRef="receive_ship" messageRef="Response_Ship" />
    <bpmn:messageFlow id="Message_Request_deliver" sourceRef="send_deliver" targetRef="start_deliver" messageRef="Request_Deliver" />
    <bpmn:messageFlow id="Message_Response_deliver" sourceRef="result_deliver" targetRef="receive_deliver" messageRef="Response_Deliver" />
    <bpmn:messageFlow id="Message_Request_cancel" sourceRef="send_cancel" targetRef="start_cancel" messageRef="Request_Cancel" />
    <bpmn:messageFlow id="Message_Response_cancel" sourceRef="result_cancel" targetRef="receive_cancel" messageRef="Response_Cancel" />
  </bpmn:collaboration>
  <bpmn:process id="Process_seller" name="Продавец" isExecutable="false" definitionalCollaborationRef="Collaboration_Fulfillment">
    <bpmn:documentation>Контекст оплаченного заказа известен при начале сценария. Каждое сообщение-запрос создаёт отдельный экземпляр серверной обработки.</bpmn:documentation>
    <bpmn:property id="seller_order" name="orderContext" itemSubjectRef="Item_OrderContext" />
    <bpmn:property id="ship_response" name="ship_response" itemSubjectRef="Item_ActionResult" />
    <bpmn:property id="deliver_response" name="deliver_response" itemSubjectRef="Item_ActionResult" />
    <bpmn:startEvent id="seller_start" name="Заказ оплачен (paid)">
      <bpmn:outgoing>Sequence_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="seller_ship" name="Подготовить заказ; нажать «Отправить»">
      <bpmn:incoming>Sequence_1</bpmn:incoming>
      <bpmn:outgoing>Sequence_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_ship" name="Отправить запрос отправки" messageRef="Request_Ship" implementation="##unspecified">
      <bpmn:incoming>Sequence_2</bpmn:incoming>
      <bpmn:outgoing>Sequence_3</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_send_ship">
        <bpmn:dataInput id="Payload_send_ship" name="Запрос" itemSubjectRef="Item_OrderContext" />
        <bpmn:inputSet id="InputSet_send_ship">
          <bpmn:dataInputRefs>Payload_send_ship</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_send_ship" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Bind_send_ship">
        <bpmn:sourceRef>seller_order</bpmn:sourceRef>
        <bpmn:targetRef>Payload_send_ship</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_ship" name="Получить результат отправки" messageRef="Response_Ship" implementation="##unspecified">
      <bpmn:incoming>Sequence_3</bpmn:incoming>
      <bpmn:outgoing>Sequence_4</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_receive_ship">
        <bpmn:dataOutput id="Payload_receive_ship" name="Результат" itemSubjectRef="Item_ActionResult" />
        <bpmn:inputSet id="InputSet_receive_ship" />
        <bpmn:outputSet id="OutputSet_receive_ship">
          <bpmn:dataOutputRefs>Payload_receive_ship</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Bind_receive_ship">
        <bpmn:sourceRef>Payload_receive_ship</bpmn:sourceRef>
        <bpmn:targetRef>ship_response</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="ship_ok" name="Отправка выполнена?" gatewayDirection="Diverging">
      <bpmn:incoming>Sequence_4</bpmn:incoming>
      <bpmn:outgoing>Sequence_12</bpmn:outgoing>
      <bpmn:outgoing>Sequence_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="seller_deliver" name="Продавец нажимает «Доставлен»">
      <bpmn:incoming>Sequence_12</bpmn:incoming>
      <bpmn:outgoing>Sequence_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_deliver" name="Отправить запрос доставки" messageRef="Request_Deliver" implementation="##unspecified">
      <bpmn:incoming>Sequence_5</bpmn:incoming>
      <bpmn:outgoing>Sequence_6</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_send_deliver">
        <bpmn:dataInput id="Payload_send_deliver" name="Запрос" itemSubjectRef="Item_OrderContext" />
        <bpmn:inputSet id="InputSet_send_deliver">
          <bpmn:dataInputRefs>Payload_send_deliver</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_send_deliver" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Bind_send_deliver">
        <bpmn:sourceRef>seller_order</bpmn:sourceRef>
        <bpmn:targetRef>Payload_send_deliver</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_deliver" name="Получить результат доставки" messageRef="Response_Deliver" implementation="##unspecified">
      <bpmn:incoming>Sequence_6</bpmn:incoming>
      <bpmn:outgoing>Sequence_7</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_receive_deliver">
        <bpmn:dataOutput id="Payload_receive_deliver" name="Результат" itemSubjectRef="Item_ActionResult" />
        <bpmn:inputSet id="InputSet_receive_deliver" />
        <bpmn:outputSet id="OutputSet_receive_deliver">
          <bpmn:dataOutputRefs>Payload_receive_deliver</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Bind_receive_deliver">
        <bpmn:sourceRef>Payload_receive_deliver</bpmn:sourceRef>
        <bpmn:targetRef>deliver_response</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="deliver_ok" name="Доставка выполнена?" gatewayDirection="Diverging">
      <bpmn:incoming>Sequence_7</bpmn:incoming>
      <bpmn:outgoing>Sequence_18</bpmn:outgoing>
      <bpmn:outgoing>Sequence_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="seller_done" name="Заказ исполнен">
      <bpmn:incoming>Sequence_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ship_rejected" name="Отправка отклонена">
      <bpmn:incoming>Sequence_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="deliver_rejected" name="Статус не обновлён">
      <bpmn:incoming>Sequence_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Sequence_1" sourceRef="seller_start" targetRef="seller_ship" />
    <bpmn:sequenceFlow id="Sequence_2" sourceRef="seller_ship" targetRef="send_ship" />
    <bpmn:sequenceFlow id="Sequence_3" sourceRef="send_ship" targetRef="receive_ship" />
    <bpmn:sequenceFlow id="Sequence_4" sourceRef="receive_ship" targetRef="ship_ok" />
    <bpmn:sequenceFlow id="Sequence_5" sourceRef="seller_deliver" targetRef="send_deliver" />
    <bpmn:sequenceFlow id="Sequence_6" sourceRef="send_deliver" targetRef="receive_deliver" />
    <bpmn:sequenceFlow id="Sequence_7" sourceRef="receive_deliver" targetRef="deliver_ok" />
    <bpmn:sequenceFlow id="Sequence_12" sourceRef="ship_ok" targetRef="seller_deliver" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$ship_response/success = 'true'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Sequence_13" sourceRef="ship_ok" targetRef="ship_rejected" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not($ship_response/success = 'true')</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Sequence_18" sourceRef="deliver_ok" targetRef="seller_done" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$deliver_response/success = 'true'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Sequence_19" sourceRef="deliver_ok" targetRef="deliver_rejected" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not($deliver_response/success = 'true')</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process_marketplace" name="Маркетплейс" isExecutable="false" definitionalCollaborationRef="Collaboration_Fulfillment">
    <bpmn:documentation>Контекст оплаченного заказа известен при начале сценария. Каждое сообщение-запрос создаёт отдельный экземпляр серверной обработки.</bpmn:documentation>
    <bpmn:property id="marketplace_order" name="orderContext" itemSubjectRef="Item_OrderContext" />
    <bpmn:property id="marketplace_result" name="actionResult" itemSubjectRef="Item_ActionResult" />
    <bpmn:laneSet id="Lanes_marketplace">
      <bpmn:lane id="Lane_marketplace_0" name="Отправка">
        <bpmn:flowNodeRef>start_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result_ship</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_marketplace_1" name="Доставка">
        <bpmn:flowNodeRef>start_deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result_deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_marketplace_2" name="Отмена">
        <bpmn:flowNodeRef>start_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result_cancel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_ship" name="Запрос отправки">
      <bpmn:outgoing>Sequence_14</bpmn:outgoing>
      <bpmn:dataOutput id="Payload_start_ship" name="Запрос" itemSubjectRef="Item_OrderContext" />
      <bpmn:dataOutputAssociation id="Bind_start_ship">
        <bpmn:sourceRef>Payload_start_ship</bpmn:sourceRef>
        <bpmn:targetRef>marketplace_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:outputSet id="Set_start_ship">
        <bpmn:dataOutputRefs>Payload_start_ship</bpmn:dataOutputRefs>
      </bpmn:outputSet>
      <bpmn:messageEventDefinition id="EventDefinition_start_ship" messageRef="Request_Ship" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="process_ship" name="Проверить права и paid; paid -&gt; shipped; списать остаток и резерв в одной транзакции" implementation="##unspecified">
      <bpmn:documentation>Операция возвращает успех или отказ после проверки роли, владельца и статуса. Отправка/отмена атомарны.</bpmn:documentation>
      <bpmn:incoming>Sequence_14</bpmn:incoming>
      <bpmn:outgoing>Sequence_15</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_process_ship">
        <bpmn:dataInput id="Input_Read_ship_orders" name="Заказы" />
        <bpmn:dataInput id="Input_Read_ship_products" name="Товары" />
        <bpmn:dataInput id="Input_Request_process_ship" name="Запрос" itemSubjectRef="Item_OrderContext" />
        <bpmn:dataOutput id="Output_Write_ship_orders" name="Заказы" />
        <bpmn:dataOutput id="Output_Write_ship_products" name="Товары" />
        <bpmn:dataOutput id="Output_Result_process_ship" name="Результат действия" itemSubjectRef="Item_ActionResult" />
        <bpmn:inputSet id="InputSet_process_ship">
          <bpmn:dataInputRefs>Input_Read_ship_orders</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Input_Read_ship_products</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Input_Request_process_ship</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_process_ship">
          <bpmn:dataOutputRefs>Output_Write_ship_orders</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>Output_Write_ship_products</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>Output_Result_process_ship</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Read_ship_orders">
        <bpmn:sourceRef>ship_orders</bpmn:sourceRef>
        <bpmn:targetRef>Input_Read_ship_orders</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Read_ship_products">
        <bpmn:sourceRef>ship_products</bpmn:sourceRef>
        <bpmn:targetRef>Input_Read_ship_products</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Bind_Request_process_ship">
        <bpmn:sourceRef>marketplace_order</bpmn:sourceRef>
        <bpmn:targetRef>Input_Request_process_ship</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Write_ship_orders">
        <bpmn:sourceRef>Output_Write_ship_orders</bpmn:sourceRef>
        <bpmn:targetRef>ship_orders</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Write_ship_products">
        <bpmn:sourceRef>Output_Write_ship_products</bpmn:sourceRef>
        <bpmn:targetRef>ship_products</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Bind_Result_process_ship">
        <bpmn:sourceRef>Output_Result_process_ship</bpmn:sourceRef>
        <bpmn:targetRef>marketplace_result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="result_ship" name="Результат отправки">
      <bpmn:incoming>Sequence_15</bpmn:incoming>
      <bpmn:dataInput id="Payload_result_ship" name="Результат" itemSubjectRef="Item_ActionResult" />
      <bpmn:dataInputAssociation id="Bind_result_ship">
        <bpmn:sourceRef>marketplace_result</bpmn:sourceRef>
        <bpmn:targetRef>Payload_result_ship</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:inputSet id="Set_result_ship">
        <bpmn:dataInputRefs>Payload_result_ship</bpmn:dataInputRefs>
      </bpmn:inputSet>
      <bpmn:messageEventDefinition id="EventDefinition_result_ship" messageRef="Response_Ship" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="ship_orders" name="Заказы" dataStoreRef="Store_Orders" />
    <bpmn:dataStoreReference id="ship_products" name="Товары" dataStoreRef="Store_Products" />
    <bpmn:startEvent id="start_deliver" name="Запрос доставки">
      <bpmn:outgoing>Sequence_20</bpmn:outgoing>
      <bpmn:dataOutput id="Payload_start_deliver" name="Запрос" itemSubjectRef="Item_OrderContext" />
      <bpmn:dataOutputAssociation id="Bind_start_deliver">
        <bpmn:sourceRef>Payload_start_deliver</bpmn:sourceRef>
        <bpmn:targetRef>marketplace_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:outputSet id="Set_start_deliver">
        <bpmn:dataOutputRefs>Payload_start_deliver</bpmn:dataOutputRefs>
      </bpmn:outputSet>
      <bpmn:messageEventDefinition id="EventDefinition_start_deliver" messageRef="Request_Deliver" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="process_deliver" name="Проверить права и shipped; shipped -&gt; delivered" implementation="##unspecified">
      <bpmn:documentation>Операция возвращает успех или отказ после проверки роли, владельца и статуса. Отправка/отмена атомарны.</bpmn:documentation>
      <bpmn:incoming>Sequence_20</bpmn:incoming>
      <bpmn:outgoing>Sequence_21</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_process_deliver">
        <bpmn:dataInput id="Input_Read_deliver_orders" name="Заказы" />
        <bpmn:dataInput id="Input_Request_process_deliver" name="Запрос" itemSubjectRef="Item_OrderContext" />
        <bpmn:dataOutput id="Output_Write_deliver_orders" name="Заказы" />
        <bpmn:dataOutput id="Output_Result_process_deliver" name="Результат действия" itemSubjectRef="Item_ActionResult" />
        <bpmn:inputSet id="InputSet_process_deliver">
          <bpmn:dataInputRefs>Input_Read_deliver_orders</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Input_Request_process_deliver</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_process_deliver">
          <bpmn:dataOutputRefs>Output_Write_deliver_orders</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>Output_Result_process_deliver</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Read_deliver_orders">
        <bpmn:sourceRef>deliver_orders</bpmn:sourceRef>
        <bpmn:targetRef>Input_Read_deliver_orders</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Bind_Request_process_deliver">
        <bpmn:sourceRef>marketplace_order</bpmn:sourceRef>
        <bpmn:targetRef>Input_Request_process_deliver</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Write_deliver_orders">
        <bpmn:sourceRef>Output_Write_deliver_orders</bpmn:sourceRef>
        <bpmn:targetRef>deliver_orders</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Bind_Result_process_deliver">
        <bpmn:sourceRef>Output_Result_process_deliver</bpmn:sourceRef>
        <bpmn:targetRef>marketplace_result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="result_deliver" name="Результат доставки">
      <bpmn:incoming>Sequence_21</bpmn:incoming>
      <bpmn:dataInput id="Payload_result_deliver" name="Результат" itemSubjectRef="Item_ActionResult" />
      <bpmn:dataInputAssociation id="Bind_result_deliver">
        <bpmn:sourceRef>marketplace_result</bpmn:sourceRef>
        <bpmn:targetRef>Payload_result_deliver</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:inputSet id="Set_result_deliver">
        <bpmn:dataInputRefs>Payload_result_deliver</bpmn:dataInputRefs>
      </bpmn:inputSet>
      <bpmn:messageEventDefinition id="EventDefinition_result_deliver" messageRef="Response_Deliver" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="deliver_orders" name="Заказы" dataStoreRef="Store_Orders" />
    <bpmn:startEvent id="start_cancel" name="Запрос отмены">
      <bpmn:outgoing>Sequence_26</bpmn:outgoing>
      <bpmn:dataOutput id="Payload_start_cancel" name="Запрос" itemSubjectRef="Item_OrderContext" />
      <bpmn:dataOutputAssociation id="Bind_start_cancel">
        <bpmn:sourceRef>Payload_start_cancel</bpmn:sourceRef>
        <bpmn:targetRef>marketplace_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:outputSet id="Set_start_cancel">
        <bpmn:dataOutputRefs>Payload_start_cancel</bpmn:dataOutputRefs>
      </bpmn:outputSet>
      <bpmn:messageEventDefinition id="EventDefinition_start_cancel" messageRef="Request_Cancel" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="process_cancel" name="Проверить права и paid; paid -&gt; cancelled; освободить резерв в одной транзакции" implementation="##unspecified">
      <bpmn:documentation>Операция возвращает успех или отказ после проверки роли, владельца и статуса. Отправка/отмена атомарны.</bpmn:documentation>
      <bpmn:incoming>Sequence_26</bpmn:incoming>
      <bpmn:outgoing>Sequence_27</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_process_cancel">
        <bpmn:dataInput id="Input_Read_cancel_orders" name="Заказы" />
        <bpmn:dataInput id="Input_Read_cancel_products" name="Товары" />
        <bpmn:dataInput id="Input_Request_process_cancel" name="Запрос" itemSubjectRef="Item_OrderContext" />
        <bpmn:dataOutput id="Output_Write_cancel_orders" name="Заказы" />
        <bpmn:dataOutput id="Output_Write_cancel_products" name="Товары" />
        <bpmn:dataOutput id="Output_Result_process_cancel" name="Результат действия" itemSubjectRef="Item_ActionResult" />
        <bpmn:inputSet id="InputSet_process_cancel">
          <bpmn:dataInputRefs>Input_Read_cancel_orders</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Input_Read_cancel_products</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Input_Request_process_cancel</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_process_cancel">
          <bpmn:dataOutputRefs>Output_Write_cancel_orders</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>Output_Write_cancel_products</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>Output_Result_process_cancel</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Read_cancel_orders">
        <bpmn:sourceRef>cancel_orders</bpmn:sourceRef>
        <bpmn:targetRef>Input_Read_cancel_orders</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Read_cancel_products">
        <bpmn:sourceRef>cancel_products</bpmn:sourceRef>
        <bpmn:targetRef>Input_Read_cancel_products</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Bind_Request_process_cancel">
        <bpmn:sourceRef>marketplace_order</bpmn:sourceRef>
        <bpmn:targetRef>Input_Request_process_cancel</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Write_cancel_orders">
        <bpmn:sourceRef>Output_Write_cancel_orders</bpmn:sourceRef>
        <bpmn:targetRef>cancel_orders</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Write_cancel_products">
        <bpmn:sourceRef>Output_Write_cancel_products</bpmn:sourceRef>
        <bpmn:targetRef>cancel_products</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Bind_Result_process_cancel">
        <bpmn:sourceRef>Output_Result_process_cancel</bpmn:sourceRef>
        <bpmn:targetRef>marketplace_result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="result_cancel" name="Результат отмены">
      <bpmn:incoming>Sequence_27</bpmn:incoming>
      <bpmn:dataInput id="Payload_result_cancel" name="Результат" itemSubjectRef="Item_ActionResult" />
      <bpmn:dataInputAssociation id="Bind_result_cancel">
        <bpmn:sourceRef>marketplace_result</bpmn:sourceRef>
        <bpmn:targetRef>Payload_result_cancel</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:inputSet id="Set_result_cancel">
        <bpmn:dataInputRefs>Payload_result_cancel</bpmn:dataInputRefs>
      </bpmn:inputSet>
      <bpmn:messageEventDefinition id="EventDefinition_result_cancel" messageRef="Response_Cancel" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="cancel_orders" name="Заказы" dataStoreRef="Store_Orders" />
    <bpmn:dataStoreReference id="cancel_products" name="Товары" dataStoreRef="Store_Products" />
    <bpmn:sequenceFlow id="Sequence_14" sourceRef="start_ship" targetRef="process_ship" />

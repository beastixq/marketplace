    <bpmn:sequenceFlow id="Sequence_27" sourceRef="process_cancel" targetRef="result_cancel" />
  </bpmn:process>
  <bpmn:process id="Process_buyer" name="Покупатель" isExecutable="false" definitionalCollaborationRef="Collaboration_Fulfillment">
    <bpmn:documentation>Контекст оплаченного заказа известен при начале сценария. Каждое сообщение-запрос создаёт отдельный экземпляр серверной обработки.</bpmn:documentation>
    <bpmn:property id="buyer_order" name="orderContext" itemSubjectRef="Item_OrderContext" />
    <bpmn:property id="cancel_response" name="cancel_response" itemSubjectRef="Item_ActionResult" />
    <bpmn:startEvent id="buyer_start" name="Заказ оплачен (paid)">
      <bpmn:outgoing>Sequence_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="buyer_cancel" name="Нажать «Отменить» до отправки">
      <bpmn:incoming>Sequence_8</bpmn:incoming>
      <bpmn:outgoing>Sequence_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_cancel" name="Отправить запрос отмены" messageRef="Request_Cancel" implementation="##unspecified">
      <bpmn:incoming>Sequence_9</bpmn:incoming>
      <bpmn:outgoing>Sequence_10</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_send_cancel">
        <bpmn:dataInput id="Payload_send_cancel" name="Запрос" itemSubjectRef="Item_OrderContext" />
        <bpmn:inputSet id="InputSet_send_cancel">
          <bpmn:dataInputRefs>Payload_send_cancel</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_send_cancel" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Bind_send_cancel">
        <bpmn:sourceRef>buyer_order</bpmn:sourceRef>
        <bpmn:targetRef>Payload_send_cancel</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_cancel" name="Получить результат отмены" messageRef="Response_Cancel" implementation="##unspecified">
      <bpmn:incoming>Sequence_10</bpmn:incoming>
      <bpmn:outgoing>Sequence_11</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_receive_cancel">
        <bpmn:dataOutput id="Payload_receive_cancel" name="Результат" itemSubjectRef="Item_ActionResult" />
        <bpmn:inputSet id="InputSet_receive_cancel" />
        <bpmn:outputSet id="OutputSet_receive_cancel">
          <bpmn:dataOutputRefs>Payload_receive_cancel</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Bind_receive_cancel">
        <bpmn:sourceRef>Payload_receive_cancel</bpmn:sourceRef>
        <bpmn:targetRef>cancel_response</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="cancel_ok" name="Отмена выполнена?" gatewayDirection="Diverging">
      <bpmn:incoming>Sequence_11</bpmn:incoming>
      <bpmn:outgoing>Sequence_24</bpmn:outgoing>
      <bpmn:outgoing>Sequence_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="buyer_done" name="Заказ отменён">
      <bpmn:incoming>Sequence_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="cancel_rejected" name="Отмена отклонена">
      <bpmn:incoming>Sequence_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Sequence_8" sourceRef="buyer_start" targetRef="buyer_cancel" />
    <bpmn:sequenceFlow id="Sequence_9" sourceRef="buyer_cancel" targetRef="send_cancel" />
    <bpmn:sequenceFlow id="Sequence_10" sourceRef="send_cancel" targetRef="receive_cancel" />
    <bpmn:sequenceFlow id="Sequence_11" sourceRef="receive_cancel" targetRef="cancel_ok" />
    <bpmn:sequenceFlow id="Sequence_24" sourceRef="cancel_ok" targetRef="buyer_done" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$cancel_response/success = 'true'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Sequence_25" sourceRef="cancel_ok" targetRef="cancel_rejected" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not($cancel_response/success = 'true')</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

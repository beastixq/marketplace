{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "share": "manual",
  "snapshot": true,
  "lsp": true,
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "deny",
    "external_directory": "ask",
    "task": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "go version": "allow",
      "go env*": "allow",
      "go test*": "allow",
      "go build*": "allow",
      "go generate*": "allow",
      "go tool*": "allow",
      "gofmt*": "allow",
      "mockgen*": "allow",
      "make*": "allow",
      "docker compose ps*": "allow",
      "docker compose up*": "allow",
      "goose *": "allow",
      "psql *": "allow"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "DBCourseWork/**",
      "PPO_labs/**",
      "diagrams/out/**",
      "diagrams/old/**",
      "reviews/**",
      "prompts/**",
      "caveman/**",
      "dist/**",
      "logs/**",
      "internal/mocks/**",
      "plantuml.jar"
    ]
  }
}
